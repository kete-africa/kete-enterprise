{
  "name": "@kete-enterprise/api",
  "private": true,
  "type": "module",
  "description": "Kete Enterprise's API (doctrine D-029): the one door for the screens, the MCP gateway, agents and connected apps.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kete/auth": "npm:@kete-africa/auth@^0.1.0",
    "@kete/commands": "npm:@kete-africa/commands@^0.2.0",
    "@kete/sdk": "npm:@kete-africa/sdk@^0.3.0",
    "@kete/tenancy": "npm:@kete-africa/tenancy@^0.1.1",
    "hono": "^4.13.12",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kete/testing": "npm:@kete-africa/testing@^0.1.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
