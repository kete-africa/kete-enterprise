{
  "name": "kete-enterprise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm i18n:check && pnpm audit:check",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "i18n:check": "tsx tooling/check-hardcoded-strings.ts",
    "audit:check": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kete/testing": "npm:@kete-africa/testing@^0.1.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
