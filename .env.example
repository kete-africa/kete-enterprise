# kete-enterprise — every variable, never a value. Local runs read this file's copy, `.env`.

# Integration tests: a real Postgres. The Neon "test" branch of the kete-enterprise project, or
# KETE_TEST_POSTGRES=container (needs Docker). Owner role: migrations; application role: no BYPASSRLS.
KETE_TEST_OWNER_URL=
KETE_TEST_APP_URL=
KETE_TEST_POSTGRES=

# apps/api
DATABASE_URL=
OWNER_DATABASE_URL=
# The identity: the Compte Kete on the shared instance, the instance's own identity otherwise.
KETE_ACCOUNT_URL=
KETE_ENVIRONMENT=development
# Where copilots reach the API: the MCP gateway is <PUBLIC_API_URL>/mcp.
PUBLIC_API_URL=
# "true": the worker (agents waking, e-mails leaving) runs beside the API, in one container.
KETE_WORKER_IN_PROCESS=
# Where people open the screens: the personal links of e-mails point there (spec 010).
PUBLIC_WEB_URL=
# "capture" (default): no e-mail leaves, they land in the test outbox. "send": through the provider.
KETE_MAIL_MODE=capture
MAILKITE_API_KEY=
KETE_MAIL_FROM=

# apps/web
PUBLIC_URL=
API_URL=
KETE_CLIENT_ID=
KETE_CLIENT_SECRET=
# on: the agents carry a mandate to the team's apps (spec 024) — the client above must hold
# kete:mandate at the Compte Kete (pnpm clients grant --client <id> --mandate). Off: the person's token.
KETE_MANDATES=
# Seals the keys people bring for their own AI connection (spec 026): 32 random bytes, base64.
KETE_SECRETS_KEY=
# Each person's own machine for her own AI subscription (spec 026b); empty: not offered.
KETE_SANDBOX_API_KEY=
# The model her subscription answers with (default gpt-6.1-sol).
KETE_SUBSCRIPTION_MODEL=
SESSION_SECRET=

# The app factory (spec 021): its address and the key it shares with this API (>= 32 bytes).
FACTORY_URL=
FACTORY_KID=
FACTORY_SECRET=
# Web Push (spec 030): a VAPID pair (pnpm dlx web-push generate-vapid-keys); empty: no push.
KETE_VAPID_PUBLIC_KEY=
KETE_VAPID_PRIVATE_KEY=
KETE_VAPID_SUBJECT=
